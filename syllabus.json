      "examples": [
        {"id": "7-1", "pattern": "dst-basic", "level": 1, "model": "journey",
         "story": "A van travelled at a uniform speed of 72 km/h for 2 h 30 min. How far did it travel?",
         "known": ["speed = 72 km/h", "time = 2 h 30 min = 2.5 h"], "asked": "distance",
         "answer": 180, "unit": "km", "answer_expr": "72 * 2.5"},
        {"id": "7-2", "pattern": "time-convert", "level": 2, "model": "journey",
         "story": "Mei Ling cycled 9 km in 45 minutes. What was her speed in km/h?",
         "known": ["distance = 9 km", "time = 45 min = 3/4 h"], "asked": "speed in km/h",
         "answer": 12, "unit": "km/h", "answer_expr": "9 / (45 / 60)"},
        {"id": "7-3", "pattern": "average-speed", "level": 2, "model": "journey",
         "story": "A car travelled 180 km at 60 km/h. It then travelled another 60 km at 30 km/h. What was its average speed for the whole journey?",
         "known": ["part 1: 180 km at 60 km/h", "part 2: 60 km at 30 km/h"], "asked": "average speed for whole journey",
         "answer": 48, "unit": "km/h", "answer_expr": "(180 + 60) / (180 / 60 + 60 / 30)",
         "trap_answer": 45, "trap_note": "(60 + 30) / 2 = 45 adalah jawaban jebakan"},
        {"id": "7-4", "pattern": "towards", "level": 2, "model": "journey",
         "story": "Town A and Town B are 270 km apart. A lorry leaves Town A for Town B at 50 km/h. At the same time, a car leaves Town B for Town A at 85 km/h. After how many hours do they meet?",
         "known": ["distance apart = 270 km", "lorry 50 km/h", "car 85 km/h", "start at the same time, towards each other"], "asked": "time until they meet",
         "answer": 2, "unit": "h", "answer_expr": "270 / (50 + 85)"},
        {"id": "7-5", "pattern": "catch-up", "level": 3, "model": "journey",
         "story": "Ali set off from home, walking at 80 m/min. 10 minutes later, his brother cycled after him along the same road at 240 m/min. How many minutes did his brother take to catch up with Ali?",
         "known": ["Ali 80 m/min", "head start 10 min", "brother 240 m/min, same direction"], "asked": "time for brother to catch up",
         "answer": 5, "unit": "min", "answer_expr": "(80 * 10) / (240 - 80)"},
        {"id": "7-6", "pattern": "same-distance", "level": 2, "model": "journey",
         "story": "Mr Lim took 3 h to drive from Town P to Town Q at 80 km/h. How long would he take for the same journey if he drove at 96 km/h?",
         "known": ["time 3 h at 80 km/h"], "asked": "time at 96 km/h",
         "answer": 2.5, "unit": "h", "answer_expr": "(80 * 3) / 96"}
      ]
